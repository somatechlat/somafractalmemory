# SomaFractalMemory Environment Configuration
# Copy this file to .env and customize for your environment.
#
# VIBE secret contract: Vault owns every secret. ENV carries system
# configuration / platform topology ONLY — hosts, ports, URLs, modes, flags.
# No user credentials. No DB passwords. No DSNs. No keys. No tokens.
#
# A blank `VAR=` is deliberately never written here: it invites a paste-and-push.
# Each secret below names its Vault path instead.

# Django Security
# SOMA_SECRET_KEY is read from Vault at runtime: secret/agent/credentials/soma_secret_key
SOMA_ALLOWED_HOSTS=*

# API auth token
# SOMA_API_TOKEN is read from Vault at runtime: secret/agent/credentials/soma_api_token

# API port inside container (host port is mapped via API_PORT)
# SOMA_API_PORT=10101

# Postgres
# SOMA_DB_PASSWORD is read from Vault at runtime: secret/agent/credentials/soma_db_password
# No DSN in ENV — the DSN embeds the password. Build it from user/host/port/db.
SOMA_DB_USER=somafractalmemory
SOMA_DB_NAME=somafractalmemory

# Redis
# SOMA_REDIS_PASSWORD is read from Vault at runtime: secret/agent/credentials/soma_redis_password

# Vault
# SOMA_VAULT_TOKEN is NEVER set here. The bootstrap token is injected at runtime
# from the deployer's process environment or Docker secret. A value in this file
# would be a root credential in git.

# MinIO (required for Milvus standalone)
# SOMA_MINIO_ROOT_USER is read from Vault at runtime: secret/agent/credentials/minio_access_key
# SOMA_MINIO_ROOT_PASSWORD is read from Vault at runtime: secret/agent/credentials/minio_secret_key

# Logging
SOMA_LOG_LEVEL=INFO

# JWT
# SOMA_JWT_SECRET is read from Vault at runtime: secret/agent/credentials/soma_jwt_secret

# Example: run the standalone stack
# docker compose -f infra/standalone/docker-compose.yml up -d
